{
  "name": "elite-maison-marketing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "node --env-file=.env.production scripts/build-production.mjs",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr",
    "prerender": "node --env-file=.env.production scripts/prerender.mjs",
    "ssg": "node --env-file=.env.production scripts/prerender-static.mjs",
    "verify:ssg": "node --env-file=.env.production scripts/verify-static.mjs",
    "start": "node server.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "check:release": "node --env-file=.env.production scripts/check-release.mjs",
    "qa:inquiry": "tsx scripts/qa-inquiry.mjs",
    "qa:copy": "node scripts/qa-copy.mjs",
    "qa:seo": "node scripts/qa-seo.mjs",
    "qa:release": "node scripts/qa-release.mjs",
    "qa:hosting": "node scripts/qa-hosting.mjs",
    "qa:http": "node scripts/qa-hosting.mjs",
    "qa": "node scripts/qa-playwright.mjs",
    "qa:round4": "node scripts/qa-round4.mjs",
    "qa:install-browser": "playwright install chromium",
    "qa:nojs": "node scripts/qa-nojs.mjs",
    "qa:phase3b": "node scripts/qa-phase3b.mjs",
    "qa:phase3c1": "node scripts/qa-phase3c1.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@fontsource/work-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "clsx": "^2.1.1",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "axe-core": "^4.13.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.2"
  }
}
