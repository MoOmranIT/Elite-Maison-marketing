# Production Apache policy for the static Vite build.
# Keep one canonical origin and one URL shape for cache/SEO consistency.
Options -MultiViews -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP and non-www requests to the canonical HTTPS www origin.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^www\.elitemaisonmarketing\.com$ [NC]
  RewriteRule ^ https://www.elitemaisonmarketing.com%{REQUEST_URI} [R=301,L,NE]

  # Keep the site root as /, while removing trailing slashes everywhere else.
  RewriteCond %{REQUEST_URI} !^/$
  RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

  # Legacy .html redirects (301 permanent) to the default canonical language.
  RewriteRule ^about\.html$ /ar/about [R=301,L,NE]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^case\.html$ /ar/cases/%1? [R=301,L,NE]
  RewriteCond %{QUERY_STRING} ^id=([A-Za-z0-9-]+)$
  RewriteRule ^insight\.html$ /ar/insights/%1? [R=301,L,NE]

  # Existing build files and finite prerendered route directories are served directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # No generic SPA fallback: unknown URLs fall through to Apache's real 404.
</IfModule>

# Branded 404 for unknown paths; crawlers see noindex.
ErrorDocument 404 /404.html

DirectoryIndex index.html
